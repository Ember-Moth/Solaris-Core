+int SSL_set_solaris_record_auth_callback(
+    SSL *ssl, unsigned flags, SSL_solaris_record_auth_callback callback, void *arg) {
+  auto *s = FromOpaque(ssl);
+  if (!s || !s->config || s->server || s->config->solaris_handshake_started ||
+      (s->config->solaris_auth_mode != 0 && s->config->solaris_auth_mode != 1) ||
+      (flags & ~SSL_SOLARIS_RECORD_ALLOW_FALLBACK) != 0 || callback == nullptr ||
+      SSL_is_dtls(s) || SSL_is_quic(s)) { return 0; }
+  s->config->solaris_auth_mode = 1;
+  s->config->solaris_record_flags = flags;
+  s->config->solaris_record_callback = callback;
+  s->config->solaris_record_arg = arg;
+  return 1;
+}
+
+int SSL_get_solaris_record_auth_result(const SSL *ssl) {
+  const auto *s = FromOpaque(ssl);
+  if (!s || s->s3->solaris_record_auth == SSL_SOLARIS_AUTH_REJECTED) {
+    return SSL_SOLARIS_AUTH_REJECTED;
+  }
+  return s->s3->initial_handshake_complete && !SSL_in_init(s)
+      ? s->s3->solaris_record_auth : SSL_SOLARIS_AUTH_PENDING;
+}
+
+int SSL_enable_solaris_client_finished_capture(SSL *ssl) {
+  auto *s = FromOpaque(ssl);
+  if (!s || !s->config || s->server || s->config->solaris_handshake_started ||
+      SSL_is_dtls(s) || SSL_is_quic(s)) { return 0; }
+  s->config->solaris_capture_finished = true;
+  return 1;
+}
