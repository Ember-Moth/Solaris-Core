+static bool solaris_session_tag(uint8_t out[32], const uint8_t context[32],
+                                  const uint8_t name_digest[32], const SSLSession *session) {
+  static const uint8_t domain[] = "Solaris peer authentication v1";
+  uint8_t input[sizeof(domain) + 64];
+  OPENSSL_memcpy(input, domain, sizeof(domain));
+  OPENSSL_memcpy(input + sizeof(domain), context, 32);
+  OPENSSL_memcpy(input + sizeof(domain) + 32, name_digest, 32);
+  unsigned length = 0;
+  return !session->secret.empty() &&
+      HMAC(EVP_sha256(), session->secret.data(), session->secret.size(),
+           input, sizeof(input), out, &length) != nullptr && length == 32;
+}
+
+bool ssl_solaris_session_matches(const SSL_CONFIG *config, const SSLSession *session) {
+  if (!config->solaris_peer_callback) { return session->solaris_peer_binding.empty(); }
+  uint8_t expected[32], name_digest[32];
+  const char *name = config->ssl->hostname.get();
+  SHA256(reinterpret_cast<const uint8_t *>(name), name ? strlen(name) : 0, name_digest);
+  if (session->is_server || session->is_quic || session->ssl_version != TLS1_3_VERSION ||
+      session->solaris_peer_binding.size() != 32 ||
+      !solaris_session_tag(expected, config->solaris_peer_context, name_digest, session)) {
+    return false;
+  }
+  bool matches = CRYPTO_memcmp(expected, session->solaris_peer_binding.data(), 32) == 0;
+  OPENSSL_cleanse(expected, sizeof(expected));
+  return matches;
+}
+
+bool ssl_solaris_bind_session(const SSL3_STATE *state, SSLSession *session) {
+  session->solaris_peer_binding.clear();
+  if (state->solaris_peer_auth != SSL_SOLARIS_AUTH_OK) { return true; }
+  session->solaris_peer_binding.ResizeForOverwrite(32);
+  return solaris_session_tag(session->solaris_peer_binding.data(),
+                              state->solaris_peer_context, state->solaris_peer_name_digest, session);
+}
