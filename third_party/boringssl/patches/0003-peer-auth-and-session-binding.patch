+int SSL_set_solaris_peer_auth_callback(
+    SSL *ssl, const uint8_t identity_context[32],
+    SSL_solaris_peer_auth_callback callback, void *arg) {
+  auto *s = FromOpaque(ssl);
+  if (!s || !s->config || s->server || s->config->solaris_handshake_started ||
+      (s->config->solaris_auth_mode != 0 && s->config->solaris_auth_mode != 2) ||
+      !identity_context || !callback || SSL_is_dtls(s) || SSL_is_quic(s)) {
+    return 0;
+  }
+  s->config->solaris_auth_mode = 2;
+  s->config->solaris_peer_callback = callback;
+  s->config->solaris_peer_arg = arg;
+  OPENSSL_memcpy(s->config->solaris_peer_context, identity_context, 32);
+  return 1;
+}
+
+int SSL_get_solaris_peer_auth_result(const SSL *ssl) {
+  const auto *s = FromOpaque(ssl);
+  if (!s || s->s3->solaris_peer_auth == SSL_SOLARIS_AUTH_REJECTED) {
+    return SSL_SOLARIS_AUTH_REJECTED;
+  }
+  return s->s3->initial_handshake_complete && !SSL_in_init(s)
+      ? s->s3->solaris_peer_auth : SSL_SOLARIS_AUTH_PENDING;
+}
