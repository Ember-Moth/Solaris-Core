+int SSL_set1_solaris_eager_key_shares(
+    SSL *ssl, const uint16_t *group_ids, size_t num_group_ids) {
+  auto *s = FromOpaque(ssl);
+  if (!s || !s->config || s->server || s->config->solaris_handshake_started ||
+      !group_ids || num_group_ids == 0 || num_group_ids > 3 ||
+      SSL_is_dtls(s) || SSL_is_quic(s) || s->config->solaris_peer_callback) { return 0; }
+  for (size_t i = 0; i < num_group_ids; i++) {
+    if (group_ids[i] != SSL_GROUP_X25519 && group_ids[i] != SSL_GROUP_SECP256R1 &&
+        group_ids[i] != SSL_GROUP_SECP384R1) { return 0; }
+    for (size_t j = 0; j < i; j++) { if (group_ids[j] == group_ids[i]) { return 0; } }
+  }
+  s->config->solaris_eager_groups.CopyFrom(Span(group_ids, num_group_ids));
+  return 1;
+}
+
+int SSL_get0_solaris_eager_key_share(
+    const SSL *ssl, uint16_t group_id, const uint8_t **out, size_t *out_len) {
+  if (out) { *out = nullptr; }
+  if (out_len) { *out_len = 0; }
+  if (!out || !out_len) { return 0; }
+  const auto *s = FromOpaque(ssl);
+  if (!s || !s->config || !s->config->solaris_hello_active || !s->s3->hs) { return 0; }
+  for (size_t i = 0; i < s->config->solaris_eager_groups.size(); i++) {
+    if (s->config->solaris_eager_groups[i] == group_id) {
+      const auto &key = s->s3->hs->solaris_eager_public[i];
+      *out = key.data();
+      *out_len = key.size();
+      return !key.empty();
+    }
+  }
+  return 0;
 }
 
