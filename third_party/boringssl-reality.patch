+int SSL_set_reality_client_auth(SSL *ssl, const uint8_t public_key[32],
+                                const uint8_t short_id[8]) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config || ssl_impl->server || public_key == nullptr ||
+      short_id == nullptr) {
+    return 0;
+  }
+  OPENSSL_memcpy(ssl_impl->config->reality_public_key, public_key, 32);
+  OPENSSL_memcpy(ssl_impl->config->reality_short_id, short_id, 8);
+  ssl_impl->config->reality_enabled = true;
+  return 1;
+}
