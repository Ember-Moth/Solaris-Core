+int SSL_get0_reality_auth_key(const SSL *ssl, const uint8_t **out_key,
+                              size_t *out_len) {
+  const auto *ssl_impl = FromOpaque(ssl);
+  if (out_key == nullptr || out_len == nullptr || ssl_impl->s3->hs == nullptr ||
+      !ssl_impl->s3->hs->reality_auth_key_valid) {
+    return 0;
+  }
+  *out_key = ssl_impl->s3->hs->reality_auth_key;
+  *out_len = sizeof(ssl_impl->s3->hs->reality_auth_key);
+  return 1;
+}
