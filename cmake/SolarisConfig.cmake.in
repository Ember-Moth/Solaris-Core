@PACKAGE_INIT@

set(Solaris_VERSION "@PROJECT_VERSION@")
set(Solaris_CORE_ENGINE_ABI_VERSION 2)
set(Solaris_CORE_CONFIG_SCHEMA "aproxy.proxy-config")
set(Solaris_CORE_CONFIG_SCHEMA_VERSION 2)

if(NOT TARGET Solaris::core AND
   EXISTS "${CMAKE_CURRENT_LIST_DIR}/SolarisTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/SolarisTargets.cmake")
endif()

if(NOT TARGET Solaris::core)
    add_library(Solaris::core UNKNOWN IMPORTED)
    set(_solaris_core_library
        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@SOLARIS_CORE_INSTALLED_LIBRARY@")
    set_target_properties(Solaris::core PROPERTIES
        IMPORTED_LOCATION "${_solaris_core_library}"
        INTERFACE_INCLUDE_DIRECTORIES
            "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
    unset(_solaris_core_library)
endif()

check_required_components(Solaris)
