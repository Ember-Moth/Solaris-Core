set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${PROJECT_SOURCE_DIR}/modules/builtin.json")
file(READ "${PROJECT_SOURCE_DIR}/modules/builtin.json" solaris_manifest)

function(solaris_json_array out)
    string(JSON count LENGTH "${solaris_manifest}" ${ARGN})
    set(result)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON value GET "${solaris_manifest}" ${ARGN} ${index})
            list(APPEND result "${value}")
        endforeach()
    endif()
    set(${out} "${result}" PARENT_SCOPE)
endfunction()

set(SOLARIS_SOURCES)
set(SOLARIS_DEPENDENCIES)
string(JSON solaris_module_count LENGTH "${solaris_manifest}" modules)
math(EXPR solaris_module_last "${solaris_module_count} - 1")
set(solaris_module_names)
foreach(index RANGE 0 ${solaris_module_last})
    string(JSON name GET "${solaris_manifest}" modules ${index} name)
    if(name IN_LIST solaris_module_names)
        message(FATAL_ERROR "Duplicate Solaris module: ${name}")
    endif()
    list(APPEND solaris_module_names "${name}")
    solaris_json_array(sources modules ${index} sources)
    solaris_json_array(dependencies modules ${index} dependencies)
    list(APPEND SOLARIS_SOURCES ${sources})
    list(APPEND SOLARIS_DEPENDENCIES ${dependencies})
endforeach()
list(REMOVE_DUPLICATES SOLARIS_DEPENDENCIES)
solaris_json_array(SOLARIS_PUBLIC_HEADERS public_headers)
solaris_json_array(SOLARIS_EXPORTS exports)

foreach(source IN LISTS SOLARIS_SOURCES)
    if(NOT source MATCHES "^src/" OR NOT EXISTS "${PROJECT_SOURCE_DIR}/${source}")
        message(FATAL_ERROR "Invalid Solaris module source: ${source}")
    endif()
endforeach()
foreach(header IN LISTS SOLARIS_PUBLIC_HEADERS)
    if(NOT header MATCHES "^include/solaris/" OR
       NOT EXISTS "${PROJECT_SOURCE_DIR}/${header}")
        message(FATAL_ERROR "Invalid public Solaris header: ${header}")
    endif()
endforeach()
set(solaris_seen_exports)
set(solaris_elf_exports "{\n  global:\n")
set(solaris_apple_exports "")
set(solaris_windows_exports "EXPORTS\n")
set(solaris_expected_exports "")
foreach(symbol IN LISTS SOLARIS_EXPORTS)
    if(NOT symbol MATCHES "^solaris_[a-z0-9_]+$" OR symbol IN_LIST solaris_seen_exports)
        message(FATAL_ERROR "Invalid or duplicate Solaris export: ${symbol}")
    endif()
    list(APPEND solaris_seen_exports "${symbol}")
    string(APPEND solaris_elf_exports "    ${symbol};\n")
    string(APPEND solaris_apple_exports "_${symbol}\n")
    string(APPEND solaris_windows_exports "    ${symbol}\n")
    string(APPEND solaris_expected_exports "${symbol}\n")
endforeach()
string(APPEND solaris_elf_exports "  local: *;\n};\n")
file(MAKE_DIRECTORY "${PROJECT_BINARY_DIR}/generated")
file(WRITE "${PROJECT_BINARY_DIR}/generated/solaris.map" "${solaris_elf_exports}")
file(WRITE "${PROJECT_BINARY_DIR}/generated/solaris.exports" "${solaris_apple_exports}")
file(WRITE "${PROJECT_BINARY_DIR}/generated/solaris.def" "${solaris_windows_exports}")
file(WRITE "${PROJECT_BINARY_DIR}/generated/exports.txt" "${solaris_expected_exports}")
