set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${PROJECT_SOURCE_DIR}/modules/builtin.json")
file(READ "${PROJECT_SOURCE_DIR}/modules/builtin.json" solaris_manifest)

function(solaris_json_array out)
    string(JSON count LENGTH "${solaris_manifest}" ${ARGN})
    set(result)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON value GET "${solaris_manifest}" ${ARGN} ${index})
            list(APPEND result "${value}")
        endforeach()
    endif()
    set(${out} "${result}" PARENT_SCOPE)
endfunction()

set(SOLARIS_SOURCES)
set(SOLARIS_DEPENDENCIES)
string(JSON solaris_module_count LENGTH "${solaris_manifest}" modules)
math(EXPR solaris_module_last "${solaris_module_count} - 1")
set(solaris_module_names)
set(solaris_enabled_modules)
set(solaris_descriptor_symbols)
set(solaris_registry_declarations "#include \"contracts/module/module.h\"\n")
set(solaris_registry_entries "")
set(solaris_module_defines "#ifndef SOLARIS_BUILTIN_MODULES_H\n#define SOLARIS_BUILTIN_MODULES_H\n")
foreach(index RANGE 0 ${solaris_module_last})
    string(JSON name GET "${solaris_manifest}" modules ${index} name)
    if(NOT name MATCHES "^[a-z][a-z0-9_]*$" OR name IN_LIST solaris_module_names)
        message(FATAL_ERROR "Invalid or duplicate Solaris module: ${name}")
    endif()
    list(APPEND solaris_module_names "${name}")
    string(JSON build_option ERROR_VARIABLE no_option GET "${solaris_manifest}" modules ${index} option)
    set(enabled ON)
    if(NOT no_option)
        if(NOT build_option MATCHES "^SOLARIS_ENABLE_[A-Z0-9_]+$")
            message(FATAL_ERROR "Invalid module option: ${build_option}")
        endif()
        option(${build_option} "Build Solaris module ${name}" ON)
        set(enabled ${${build_option}})
    endif()
    if(name MATCHES "^tun_(lwip|system)$" AND NOT SOLARIS_ENABLE_TUN)
        set(enabled OFF)
    endif()
    string(TOUPPER "${name}" upper_name)
    if(enabled)
        list(APPEND solaris_enabled_modules "${name}")
        string(APPEND solaris_module_defines "#define SOLARIS_HAS_${upper_name} 1\n")
    else()
        string(APPEND solaris_module_defines "#define SOLARIS_HAS_${upper_name} 0\n")
        continue()
    endif()
    solaris_json_array(sources modules ${index} sources)
    solaris_json_array(dependencies modules ${index} dependencies)
    list(APPEND SOLARIS_SOURCES ${sources})
    list(APPEND SOLARIS_DEPENDENCIES ${dependencies})
    string(JSON descriptor ERROR_VARIABLE no_descriptor GET "${solaris_manifest}" modules ${index} descriptor)
    if(NOT no_descriptor)
        if(NOT descriptor MATCHES "^solaris_[a-z0-9_]+_module$" OR descriptor IN_LIST solaris_descriptor_symbols)
            message(FATAL_ERROR "Invalid or duplicate descriptor: ${descriptor}")
        endif()
        list(APPEND solaris_descriptor_symbols "${descriptor}")
        string(APPEND solaris_registry_declarations "extern const solaris_outbound_module_t ${descriptor};\n")
        string(APPEND solaris_registry_entries "    &${descriptor},\n")
    endif()
endforeach()
list(LENGTH solaris_descriptor_symbols solaris_outbound_count)
string(APPEND solaris_module_defines "#define SOLARIS_BUILTIN_OUTBOUND_COUNT ${solaris_outbound_count}\n")
foreach(index RANGE 0 ${solaris_module_last})
    string(JSON name GET "${solaris_manifest}" modules ${index} name)
    if(NOT name IN_LIST solaris_enabled_modules)
        continue()
    endif()
    string(JSON requirements ERROR_VARIABLE no_requirements GET "${solaris_manifest}" modules ${index} requires)
    if(NOT no_requirements)
        solaris_json_array(requirements modules ${index} requires)
        foreach(required IN LISTS requirements)
            if(NOT required IN_LIST solaris_enabled_modules)
                message(FATAL_ERROR "Solaris module ${name} requires missing or disabled module ${required}")
            endif()
        endforeach()
    endif()
endforeach()
list(REMOVE_DUPLICATES SOLARIS_DEPENDENCIES)
solaris_json_array(SOLARIS_PUBLIC_HEADERS public_headers)
solaris_json_array(SOLARIS_EXPORTS exports)

foreach(source IN LISTS SOLARIS_SOURCES)
    if(NOT source MATCHES "^src/" OR NOT EXISTS "${PROJECT_SOURCE_DIR}/${source}")
        message(FATAL_ERROR "Invalid Solaris module source: ${source}")
    endif()
endforeach()
foreach(header IN LISTS SOLARIS_PUBLIC_HEADERS)
    if(NOT header MATCHES "^include/solaris/" OR
       NOT EXISTS "${PROJECT_SOURCE_DIR}/${header}")
        message(FATAL_ERROR "Invalid public Solaris header: ${header}")
    endif()
endforeach()
set(solaris_seen_exports)
set(solaris_elf_exports "{\n  global:\n")
set(solaris_apple_exports "")
set(solaris_windows_exports "EXPORTS\n")
set(solaris_expected_exports "")
foreach(symbol IN LISTS SOLARIS_EXPORTS)
    if(NOT symbol MATCHES "^solaris_[a-z0-9_]+$" OR symbol IN_LIST solaris_seen_exports)
        message(FATAL_ERROR "Invalid or duplicate Solaris export: ${symbol}")
    endif()
    list(APPEND solaris_seen_exports "${symbol}")
    string(APPEND solaris_elf_exports "    ${symbol};\n")
    string(APPEND solaris_apple_exports "_${symbol}\n")
    string(APPEND solaris_windows_exports "    ${symbol}\n")
    string(APPEND solaris_expected_exports "${symbol}\n")
endforeach()
string(APPEND solaris_elf_exports "  local: *;\n};\n")
file(MAKE_DIRECTORY "${PROJECT_BINARY_DIR}/generated")
string(APPEND solaris_module_defines "#endif\n")
file(WRITE "${PROJECT_BINARY_DIR}/generated/solaris_builtin_modules.h" "${solaris_module_defines}")
file(WRITE "${PROJECT_BINARY_DIR}/generated/solaris_builtin_modules.c"
    "${solaris_registry_declarations}\nstatic const solaris_outbound_module_t *const modules[] = {\n${solaris_registry_entries}    NULL\n};\n\nsolaris_status_t solaris_builtin_registry_create(solaris_budget_t *budget, solaris_registry_t **out, solaris_error_t *error)\n{\n    return solaris_registry_create(modules, sizeof(modules) / sizeof(modules[0]) - 1u, budget, out, error);\n}\n")
list(APPEND SOLARIS_SOURCES "${PROJECT_BINARY_DIR}/generated/solaris_builtin_modules.c")
file(WRITE "${PROJECT_BINARY_DIR}/generated/solaris.map" "${solaris_elf_exports}")
file(WRITE "${PROJECT_BINARY_DIR}/generated/solaris.exports" "${solaris_apple_exports}")
file(WRITE "${PROJECT_BINARY_DIR}/generated/solaris.def" "${solaris_windows_exports}")
file(WRITE "${PROJECT_BINARY_DIR}/generated/exports.txt" "${solaris_expected_exports}")
